{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "airbnb-management",
  "main": "./backend/src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],

  // 1. Static Assets Frontend (Serves index.html, admin.html, portal.html, js/api.js)
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS"
  },

  // 2. Cloudflare D1 Database (Edge SQLite)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airbnb-db",
      "database_id": "aa4ef584-3db3-4c2c-8bbd-873b80979869" // Replace with your D1 database ID from: npx wrangler d1 create airbnb-db
    }
  ],

  // 3. Cloudflare R2 Storage (Uncomment once R2 is enabled in Cloudflare Dashboard)
  // "r2_buckets": [
  //   {
  //     "binding": "IMAGES_BUCKET",
  //     "bucket_name": "airbnb-guest-images"
  //   }
  // ],

  // 4. Environment Variables
  "vars": {
    "ADMIN_PIN": "4635",
    "ENVIRONMENT": "production"
  },

  "observability": {
    "enabled": true
  }
}
